{
  "name": "@montevideo-world/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Constantes, mensajes, DTOs y esquemas Colyseus compartidos entre cliente y servidor",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./cities": {
      "types": "./dist/cities/index.d.ts",
      "default": "./dist/cities/index.js"
    },
    "./cities/*": {
      "types": "./dist/cities/*/map.d.ts",
      "default": "./dist/cities/*/map.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@colyseus/schema": "^3.0.0"
  },
  "devDependencies": {
    "@colyseus/schema": "^3.0.76",
    "typescript": "^5.9.3"
  }
}
