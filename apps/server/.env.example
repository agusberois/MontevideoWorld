# Puerto HTTP/WS donde escucha Colyseus
PORT=2567
# Interfaz de red (0.0.0.0 para aceptar conexiones externas en el VPS)
HOST=0.0.0.0
# Orígenes permitidos separados por coma, o * para abrir a todos (sólo en desarrollo).
# En producción: los dominios del juego, p. ej. https://montevideoworld.com,https://app.montevideoworld.com
CORS_ORIGIN=*
# Nombre con el que se entra como admin (se compara sin distinguir mayúsculas). Vacío = sin admin.
# Ojo: no hay contraseña; cualquiera que entre con ese nombre es admin.
ADMIN_NAME=
# Cuántos minutos reales dura un día del juego (por defecto 24: 1 hora del juego = 1 minuto real).
DAY_LENGTH_MINUTES=24
# Archivo donde se guarda el progreso de los jugadores (por defecto apps/server/data/players.json).
# PLAYER_DATA_FILE=/var/lib/montevideo-world/players.json
